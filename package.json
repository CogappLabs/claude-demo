{
  "name": "claude-demo",
  "version": "0.1.0",
  "description": "Tiny artwork-search API for the Claude at Cogapp workshop",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "artwork": "tsx bin/artwork.ts"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.2",
    "lefthook": "^2.1.9",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
